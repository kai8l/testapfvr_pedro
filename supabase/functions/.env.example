# Segredos das Edge Functions (NÃO vão no app). Envie com:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já existem automaticamente nas functions.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
# "Assinatura secreta" do painel Mercado Pago > Suas integrações > Webhooks (opcional, recomendado)
MP_WEBHOOK_SECRET=
